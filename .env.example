# Real multiplayer backend. Leave empty to keep GitHub Pages in demo-lobby mode.
VITE_MULTIPLAYER_HTTP_URL=http://localhost:8787

# Server-side room/session persistence. Contains session tokens; never commit the file.
VAMPIRKY_STATE_FILE=.data/vampirky-state.json

# Room lifecycle (seconds)
VAMPIRKY_RECONNECT_GRACE_SECONDS=120
VAMPIRKY_EMPTY_LOBBY_TTL_SECONDS=900
VAMPIRKY_ABANDONED_GAME_TTL_SECONDS=3600
VAMPIRKY_FINISHED_GAME_TTL_SECONDS=1800
